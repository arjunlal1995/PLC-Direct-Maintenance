<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.plc.directmaintenance">

    <!-- Network access for PLC communication -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Wi-Fi discovery and multicast -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- USB host support for compatible USB PLC adapters -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <!-- Notifications and alerts -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Restart after device boot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Full-screen notifications, where permitted -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".PLCDirectMaintenanceApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PLCDirectMaintenance"
        tools:targetApi="34">

        <!-- Main application screen -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.PLCDirectMaintenance">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- USB device attachment handling -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>

            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />

        </activity>

        <!-- Alert action receiver -->
        <receiver
            android:name=".notifications.NotificationActionReceiver"
            android:exported="false">

            <intent-filter>
                <action android:name="com.plc.directmaintenance.ACTION_ACKNOWLEDGE_ALERT" />
                <action android:name="com.plc.directmaintenance.ACTION_DISPATCH_TECH" />
                <action android:name="com.plc.directmaintenance.ACTION_SNOOZE_ALERT" />
            </intent-filter>

        </receiver>

        <!-- Background PLC monitoring service -->
        <service
            android:name=".service.DirectMaintenanceService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Restart handling after boot -->
        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="false">

            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>

        </receiver>

    </application>

</manifest>